{
  "name": "codextor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-pyodide.mjs && node scripts/gen-site.mjs && vite --host 0.0.0.0",
    "build": "node scripts/sync-pyodide.mjs && node scripts/gen-site.mjs && vite build",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "gen:site": "node scripts/gen-site.mjs",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@convex-dev/auth": "^0.0.95",
    "@lezer/highlight": "^1.2.5",
    "convex": "^1.45.0",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "convex-test": "0.0.59",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.49",
    "pyodide": "^314.0.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
