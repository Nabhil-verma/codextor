{
  "name": "codextor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-pyodide.mjs && node scripts/sync-typescript.mjs && node scripts/gen-site.mjs && vite --host 0.0.0.0",
    "build": "node scripts/sync-pyodide.mjs && node scripts/sync-typescript.mjs && node scripts/gen-site.mjs && vite build",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "gen:site": "node scripts/gen-site.mjs",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "sync:typescript": "node scripts/sync-typescript.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@convex-dev/auth": "^0.0.95",
    "@lezer/highlight": "^1.2.5",
    "convex": "^1.45.0",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.20",
    "convex-test": "0.0.59",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "postcss": "8.5.29",
    "pyodide": "^314.0.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
