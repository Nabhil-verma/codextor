        {
          "file": "src/data/track-agent-internals.ts",
          "line": 109,
          "snippet": "title: \"Evals: Measuring an Agent Without Trusting It\","
        },
        {
          "file": "src/data/track-agent-internals.ts",
          "line": 112,
          "snippet": "body: `An eval is a fixed set of tasks with checks you can run again. Its value is repeatability: the same input gives the same score, so a change in score means a change in behaviour, not in mood.\\n\\nAn agent that grades its own work is not an eval. Use executable checks where possible, and keep a held-out set that the agent never sees while you tune it. Report the failures, not just the pass rate.`,"
        },
        {
          "file": "src/data/track-agent-internals.ts",
          "line": 114,
          "snippet": "{ q: \"What makes an eval useful?\", options: [\"The agent grades its own output\", \"Fixed tasks and checks that can be rerun\", \"A high pass rate on tasks it has seen\"], answer: 1, explanation: \"Repeatable, unseen, executable checks measure behaviour.\" },"
        },
        {
          "file": "src/data/track-agent-internals.ts",
          "line": 115,
          "snippet": "{ q: \"Why hold out a set of eval tasks?\", options: [\"To save tokens\", \"To detect overfitting while tuning\", \"Because held-out tasks are always easier\"], answer: 1, explanation: \"Tuning on the same tasks inflates the score.\" },"
        }
      ]
    },
