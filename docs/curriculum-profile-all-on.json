        },
        {
          "file": "src/data/track-agents.ts",
          "line": 30,
          "snippet": "body: `**Vibe coding: accepting AI output because it looks right.** Plausible code, a polished explanation and a green badge are not interchangeable with evidence."
        },
        {
          "file": "src/data/track-agents.ts",
          "line": 46,
          "snippet": "Example: an agent says “tested locally” but supplies no output. Vibe coding accepts the claim. Agentic engineering requests the command and receipt, reproduces reversed response order, checks the test cannot pass on the bad draft, and monitors the deployed behavior."
        },
        {
          "file": "src/data/track-agents.ts",
          "line": 50,
          "snippet": "{q:\"Which is vibe coding?\",options:[\"Accepting AI output because it looks right\",\"Rejecting a plan that changes unrelated files\",\"Writing a test that catches the draft\"],answer:0,explanation:\"Appearance is substituted for evidence.\"},"
        }
      ]
