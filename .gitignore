# Generated by scripts/sync-pyodide.mjs before dev/build — 13 MB of runtime
# assets that are reproducible from node_modules and must not be committed.
public/pyodide/

# Generated by scripts/sync-typescript.mjs before dev/build — the 9 MB
# TypeScript browser build, copied from node_modules and never committed.
public/typescript/

# Compiled artifact bundle and TypeScript build cache — reproducible output,
# not source.
/isolate/
*.tsbuildinfo

# Preview screenshots captured from headless Chrome while reviewing the revamp
# UI — regenerable with scripts/preview-pixels.mjs, not source.
/.preview-shots/
/freebuff-sites-build/

# Sites deploy payload: a copy of dist/ in a directory that is neither hidden
# nor gitignored, because the deployer skips those. Regenerate per sites/README.md.
/sites/build-nopy/
