+import type { ReactNode } from "react";
+import { motion, useReducedMotion } from "framer-motion";
+import { Sparkles } from "lucide-react";
+
+export interface SocraticChatBubbleProps {
+  role: "ai" | "user";
+  children: ReactNode;
+  /** Show the floating "analyzing…" indicator instead of a message. */
+  analyzing?: boolean;
+  /** Tappable hint chips under an AI message. */
+  chips?: string[];
+  onChip?: (chip: string) => void;
+  /** Slide in on mount (live chats). Off for static mockups. */
+  animate?: boolean;
+}
+
+/** Three-dot "thinking" indicator. */
+function Dots() {
+  return (
+    <span className="inline-flex items-center gap-1" aria-hidden>
+      {[0, 1, 2].map((i) => (
+        <motion.span
+          key={i}
+          className="h-1 w-1 rounded-full bg-violet-300"
+          animate={{ opacity: [0.25, 1, 0.25], y: [0, -2, 0] }}
+          transition={{ duration: 1.1, repeat: Infinity, delay: i * 0.16 }}
+        />
+      ))}
+    </span>
+  );
+}
+
+/**
+ * One message in the Socratic tutor. AI turns sit left behind a violet halo,
+ * learner turns sit right in a quiet glass pill. No avatars, no tails —
+ * the alignment carries the speaker.
+ */
+export default function SocraticChatBubble({
+  role,
+  children,
+  analyzing = false,
+  chips,
+  onChip,
+  animate = true,
+}: SocraticChatBubbleProps) {
+  const reduce = useReducedMotion();
+  const ai = role === "ai";
+
+  return (
+    <motion.div
+      initial={animate && !reduce ? { opacity: 0, y: 10, scale: 0.98 } : false}
+      animate={{ opacity: 1, y: 0, scale: 1 }}
+      transition={{ type: "spring", stiffness: 400, damping: 30 }}
+      className={"flex " + (ai ? "justify-start" : "justify-end")}
+    >
+      <div className={"max-w-[88%] " + (ai ? "" : "text-right")}>
+        {ai && (
+          <p className="mb-1.5 flex items-center gap-1.5 font-mono text-[0.62rem] uppercase tracking-[0.22em] text-violet-300/80">
+            <Sparkles className="h-3 w-3" aria-hidden />
+            {analyzing ? "Socratic AI is analyzing" : "Socratic AI"}
+          </p>
+        )}
+        <div
+          className={
+            "rounded-2xl px-4 py-3 text-sm leading-relaxed " +
+            (ai
+              ? "border border-violet-400/20 bg-violet-500/[0.07] text-ink-800 shadow-[0_0_30px_-10px_rgba(139,92,246,0.35)]"
+              : "border border-white/10 bg-white/[0.05] text-ink-900")
+          }
+        >
+          {analyzing ? <Dots /> : children}
+        </div>
+        {ai && !analyzing && chips && chips.length > 0 && (
+          <div className="mt-2 flex flex-wrap gap-1.5">
+            {chips.map((chip) => (
+              <button
+                key={chip}
+                type="button"
+                onClick={() => onChip?.(chip)}
+                className="rounded-full border border-cyan-400/20 bg-cyan-400/[0.05] px-3 py-1 text-xs text-cyan-200 transition-all duration-300 ease-snap hover:scale-[1.03] hover:border-cyan-400/50 hover:bg-cyan-400/10 active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-cyan-400"
+              >
+                {chip}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+    </motion.div>
+  );
+}
diff --git a/src/components/ui/TypingCode.tsx b/src/components/ui/TypingCode.tsx
new file mode 100644
index 0000000..aabe271
--- /dev/null
+++ b/src/components/ui/TypingCode.tsx
@@ -0,0 +1,163 @@
+import { useEffect, useMemo, useState } from "react";
+import { useReducedMotion } from "framer-motion";
+
+/* ── A tiny JS highlighter: enough for demo snippets, no dependency. ── */
+
+type Kind = "plain" | "comment" | "string" | "keyword" | "number" | "call";
+
+const TOKEN =
+  /(\/\/.*$)|("(?:[^"\\\n]|\\.)*"?|'(?:[^'\\\n]|\\.)*'?|`(?:[^`\\]|\\.)*`?)|\b(const|let|var|function|return|if|else|for|while|async|await|import|from|export|new|class|of|in)\b|\b(\d+(?:\.\d+)?)\b|([A-Za-z_$][\w$]*)(?=\()/gm;
+
+const KIND_CLASS: Record<Kind, string> = {
+  // Fixed values, not theme tokens: code always sits on a dark surface, and
+  // `.code-window` re-pins the ink scale, which made token-based text vanish.
+  plain: "text-[#d9d9e3]",
+  comment: "text-[#7c7f93] italic",
+  string: "text-emerald-300",
+  keyword: "text-violet-300",
+  number: "text-amber-300",
+  call: "text-cyan-300",
+};
+
+interface Span {
+  text: string;
+  kind: Kind;
+}
+
+export function highlight(source: string): Span[] {
+  const out: Span[] = [];
+  let last = 0;
+  for (const m of source.matchAll(TOKEN)) {
+    const at = m.index ?? 0;
+    if (at > last) out.push({ text: source.slice(last, at), kind: "plain" });
+    const kind: Kind = m[1]
+      ? "comment"
+      : m[2]
+        ? "string"
+        : m[3]
+          ? "keyword"
+          : m[4]
+            ? "number"
+            : "call";
+    out.push({ text: m[0], kind });
+    last = at + m[0].length;
+  }
+  if (last < source.length) out.push({ text: source.slice(last), kind: "plain" });
+  return out;
+}
+
+/** Reveals `text` one character at a time. Instant under reduced motion. */
+export function useTypewriter(text: string, speed = 28, startDelay = 600) {
+  const reduce = useReducedMotion();
+  const [count, setCount] = useState(reduce ? text.length : 0);
+
+  useEffect(() => {
+    if (reduce) {
+      setCount(text.length);
+      return;
+    }
+    setCount(0);
+    let tick: ReturnType<typeof setInterval> | undefined;
+    const start = setTimeout(() => {
+      tick = setInterval(() => {
+        setCount((c) => {
+          if (c >= text.length) {
+            if (tick) clearInterval(tick);
+            return c;
+          }
+          return c + 1;
+        });
+      }, speed);
+    }, startDelay);
+    return () => {
+      clearTimeout(start);
+      if (tick) clearInterval(tick);
+    };
+  }, [text, speed, startDelay, reduce]);
+
+  return { shown: text.slice(0, count), done: count >= text.length };
+}
+
+export interface TypingCodeProps {
+  code: string;
+  /** Console line revealed once typing finishes. */
+  output?: string;
+  speed?: number;
+  startDelay?: number;
+  /** Line numbers in the gutter. */
+  gutter?: boolean;
+  className?: string;
+}
+
+/** Syntax-highlighted code that types itself, then prints its output. */
+export default function TypingCode({
+  code,
+  output,
+  speed = 28,
+  startDelay = 700,
+  gutter = true,
+  className = "",
+}: TypingCodeProps) {
+  const { shown, done } = useTypewriter(code, speed, startDelay);
+  const spans = useMemo(() => highlight(shown), [shown]);
+  const lineCount = Math.max(1, code.split("\n").length);
+  const activeLine = shown.split("\n").length;
+
+  return (
+    <div className={"flex font-mono text-[0.8rem] leading-7 " + className}>
+      {gutter && (
+        <div
+          aria-hidden
+          className="select-none pr-5 text-right text-[#6b6e82]"
+        >
+          {Array.from({ length: lineCount }, (_, i) => (
+            <div
+              key={i}
+              className={i + 1 === activeLine && !done ? "text-cyan-300" : ""}
+            >
+              {i + 1}
+            </div>
+          ))}
+        </div>
+      )}
+      <div className="min-w-0 flex-1">
+        {/* Full text is in the DOM for assistive tech; the typing is decoration. */}
+        <span className="sr-only">{code}</span>
+        <pre aria-hidden className="whitespace-pre-wrap break-words">
+          <code>
+            {spans.map((s, i) => (
+              <span key={i} className={KIND_CLASS[s.kind]}>
+                {s.text}
+              </span>
+            ))}
+            {!done && <span className="caret" />}
+          </code>
+        </pre>
+        {output && (
+          <div
+            className={
+              "mt-2 border-l-2 border-emerald-400/50 pl-3 text-emerald-300 transition-all duration-700 ease-snap " +
+              (done ? "translate-y-0 opacity-100" : "translate-y-1 opacity-0")
+            }
+          >
+            <span className="mr-2 text-[#7c7f93]">→</span>
+            {output}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+/** One statically highlighted line (for mockups that don't type). */
+export function CodeLine({ text }: { text: string }) {
+  return (
+    <>
+      {highlight(text).map((s, i) => (
+        <span key={i} className={KIND_CLASS[s.kind]}>
+          {s.text}
+        </span>
+      ))}
+    </>
+  );
+}
